{
  "name": "lev-space",
  "version": "1.0.0",
  "description": "Sistema gestionale completo per Lev Space",
  "main": "server/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop lev-space",
    "restart": "pm2 restart lev-space",
    "logs": "pm2 logs lev-space",
    "status": "pm2 status",
    "backup": "node server/backup.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "barber",
    "booking",
    "management"
  ],
  "author": "Lev Space",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.6.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  }
}
