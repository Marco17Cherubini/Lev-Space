{
  "root": true,
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": ["server/**/*.js", "config/**/*.js", "ecosystem.config.js", "test/**/*.js"],
      "env": {
        "node": true,
        "es2022": true
      }
    },
    {
      "files": ["frontend/js/**/*.js"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "vars": "local",
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true,
            "caughtErrors": "none"
          }
        ],
        "no-redeclare": [
          "error",
          {
            "builtinGlobals": false
          }
        ]
      },
      "globals": {
        "module": "readonly",
        "apiRequest": "readonly",
        "showError": "readonly",
        "showSuccess": "readonly",
        "hideMessage": "readonly",
        "formatDate": "readonly",
        "getCurrentUser": "readonly",
        "redirectToLogin": "readonly",
        "Modal": "readonly",
        "escapeHtml": "readonly",
        "APPOINTMENT_MINUTES": "readonly",
        "isFollowingSlot": "readonly",
        "MONTHS_IT": "readonly",
        "DAYS_IT": "readonly",
        "requireAuth": "readonly",
        "logout": "readonly",
        "makeSelectable": "readonly",
        "showToast": "readonly"
      }
    }
  ]
}
