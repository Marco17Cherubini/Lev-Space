{
  "root": true,
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": ["server/**/*.js", "config/**/*.js", "ecosystem.config.js", "test/**/*.js"],
      "env": {
        "node": true,
        "es2022": true
      }
    },
    {
      "files": ["frontend/js/**/*.js"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "vars": "local",
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true,
            "caughtErrors": "none"
          }
        ],
        "no-redeclare": [
          "error",
          {
            "builtinGlobals": false
          }
        ]
      },
      "globals": {
        "apiRequest": "readonly",
        "jsonBody": "readonly",
        "escapeHtml": "readonly",
        "MONTHS_IT": "readonly",
        "DAYS_IT": "readonly",
        "DAYS_SHORT_IT": "readonly",
        "parseISO": "readonly",
        "toISO": "readonly",
        "todayISO": "readonly",
        "addDays": "readonly",
        "mondayOf": "readonly",
        "formatDate": "readonly",
        "formatDateShort": "readonly",
        "formatDayMonth": "readonly",
        "slotDate": "readonly",
        "isUpcoming": "readonly",
        "byDateTime": "readonly",
        "APPOINTMENT_MINUTES": "readonly",
        "toMinutes": "readonly",
        "isFollowingSlot": "readonly",
        "showToast": "readonly",
        "setBusy": "readonly",
        "showMessage": "readonly",
        "getCurrentUser": "readonly",
        "redirectToLogin": "readonly",
        "safeNextPath": "readonly",
        "icon": "readonly",
        "groupBookings": "readonly",
        "requireAuth": "readonly",
        "logout": "readonly",
        "Sheet": "readonly",
        "usableStarts": "readonly",
        "findFirstFreeSlot": "readonly",
        "createBookingPicker": "readonly",
        "findUsualSlot": "readonly",
        "renderUsual": "readonly",
        "AgendaView": "readonly",
        "SegmentDisplay": "readonly",
        "endOf": "readonly",
        "shiftRuns": "readonly"
      }
    }
  ]
}
