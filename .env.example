# ==================== SERVER ====================
PORT=3000
# development in locale; production abilita il cookie "secure" (richiede HTTPS)
NODE_ENV=development
# URL pubblico usato nei link delle email (es. reset password)
BASE_URL=http://localhost:3000

# ==================== SICUREZZA ====================
# Obbligatorio. Stringa casuale di almeno 32 caratteri, generala con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Il server non parte se il valore è assente o è questo segnaposto.
JWT_SECRET=CAMBIA_QUESTO_CON_UNA_STRINGA_CASUALE_DI_ALMENO_64_CARATTERI

# Account amministratore, creato al primo avvio solo se la tabella admins è vuota
ADMIN_EMAIL=admin@levspace.it
ADMIN_PASSWORD=CambiaMi_ConPassword_Sicura_123!

# Facoltativo: richieste per IP ogni 15 minuti (default 20 per login/registrazione/reset, 10 per prenotazioni ospite)
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_GUEST_MAX=10

# ==================== DATABASE ====================
# Facoltativo: percorso del file SQLite (default: database/database.sqlite).
# Su Railway, ad esempio, /data/database.sqlite con un Volume montato su /data
# DATABASE_PATH=
# Facoltativo: cartella dei backup di `npm run backup` (default: backups/)
# BACKUP_DIR=

# ==================== EMAIL (Resend) ====================
# Facoltativo: senza chiave le email vengono saltate con un avviso in console
RESEND_API_KEY=
EMAIL_FROM=Lev Space <onboarding@resend.dev>

# ==================== STUDIO ====================
STUDIO_NAME=Lev Space
STUDIO_PHONE=+39 123 456 7890
STUDIO_ADDRESS=Via Example 123, 00100 Roma, Italia
